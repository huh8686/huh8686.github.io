---
import Base from '../layouts/Base.astro';
import NoteList from '../components/NoteList.astro';
import TopicList from '../components/TopicList.astro';
import { getCollection } from 'astro:content';

const notes = (await getCollection('papers', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const recent = notes.slice(0, 5);
---

<Base
  title="3D vision paper notes"
  description="3D vision 논문을 읽고, 이해한 것과 아직 빈 곳을 같은 형식으로 남기는 노트입니다."
>
  <section>
    <h1>3D vision paper notes</h1>
    <p class="lede">
      논문을 읽고, 내가 이해한 것과 아직 빈 곳을 같은 형식으로 남깁니다.
      소개 페이지가 아니라 지식 정리장입니다.
    </p>
  </section>

  <div class="split">
    <section>
      <h2 class="section-title">최근 노트</h2>
      {recent.length > 0 ? (
        <NoteList notes={recent} />
      ) : (
        <p class="lede">노트를 추가하면 여기에 최근 글이 쌓입니다.</p>
      )}
    </section>
    <section>
      <h2 class="section-title">네 축</h2>
      <TopicList compact />
    </section>
  </div>
</Base>
