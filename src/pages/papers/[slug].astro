---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { getTopic } from '../../topics';

export async function getStaticPaths() {
  const notes = await getCollection('papers', ({ data }) => !data.draft);
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
const topic = getTopic(note.data.topic);
const { Content } = await render(note);
const cite = `${note.data.paper.authors} · ${note.data.paper.venue} ${note.data.paper.year}`;
---

<Base title={note.data.title} description={note.data.summary}>
  <p class="cite">
    <a href={`/topics/${topic.id}`}>{topic.title}</a>
    · {cite}
  </p>
  <h1>{note.data.title}</h1>
  <p class="lede">{note.data.summary}</p>
  <p class="paper-title">{note.data.paper.title}</p>
  {note.data.tags.length > 0 && (
    <ul class="tags">
      {note.data.tags.map((tag) => <li>{tag}</li>)}
    </ul>
  )}
  <article class="prose">
    <Content />
  </article>
</Base>

<style>
  .paper-title {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .cite a {
    color: inherit;
    text-decoration: none;
  }
  .cite a:hover {
    text-decoration: underline;
  }
  .prose {
    margin-top: 28px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
</style>
