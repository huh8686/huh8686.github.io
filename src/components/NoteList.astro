---
import type { CollectionEntry } from 'astro:content';
import { getTopic } from '../topics';

type Props = {
  notes: CollectionEntry<'papers'>[];
};

const { notes } = Astro.props;
---

{notes.length > 0 && (
  <ol class="note-list">
    {notes.map((note) => {
      const topic = getTopic(note.data.topic);
      const cite = `${note.data.paper.authors} · ${note.data.paper.venue} ${note.data.paper.year}`;
      return (
        <li class="note">
          <p class="cite">
            <a href={`/topics/${topic.id}`}>{topic.title}</a>
            <span aria-hidden="true"> · </span>
            <span>{cite}</span>
          </p>
          <a class="title" href={`/papers/${note.id}`}>{note.data.title}</a>
          <p class="summary">{note.data.summary}</p>
        </li>
      );
    })}
  </ol>
)}

<style>
  .note-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .note {
    display: grid;
    gap: 4px;
    padding: 16px 0;
    border-top: 1px solid var(--line);
  }
  .note:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .cite {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--mark);
  }
  .cite a {
    color: inherit;
    text-decoration: none;
  }
  .cite a:hover {
    text-decoration: underline;
  }
  .title {
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
  }
  .title:hover {
    text-decoration: underline;
  }
  .summary {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
  }
</style>
